PassengerAppRoot /home/__CPANEL_USER__/serensa_app
PassengerBaseURI /
PassengerAppType wsgi
PassengerStartupFile passenger_wsgi.py
PassengerPython /home/__CPANEL_USER__/virtualenv/serensa_app/3.11/bin/python
PassengerEnabled on

<IfModule mod_rewrite.c>
    RewriteEngine On
    Options -MultiViews

    # Keep ACME challenge paths reachable for certificate renewals.
    RewriteRule ^\.well-known/ - [L]

    # Let Apache serve existing files/directories directly.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    # Route everything else into Passenger while preserving original path.
    RewriteRule ^(.*)$ passenger_wsgi.py/$1 [QSA,PT,L]
</IfModule>
