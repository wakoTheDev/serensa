# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
PassengerAppRoot /home/__CPANEL_USER__/serensa_app
PassengerBaseURI /
PassengerAppType wsgi
PassengerStartupFile passenger_wsgi.py
PassengerPython /home/__CPANEL_USER__/virtualenv/serensa_app/3.11/bin/python
PassengerEnabled on
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END

<IfModule mod_rewrite.c>
    RewriteEngine On
    Options -MultiViews

    # Allow SSL certificate renewals.
    RewriteRule ^\.well-known/ - [L]

    # Serve static files directly - bypass Passenger.
    RewriteCond %{REQUEST_URI} ^/static/
    RewriteRule ^ - [L]

    # Serve media files directly - bypass Passenger.
    RewriteCond %{REQUEST_URI} ^/media/
    RewriteRule ^ - [L]

    # Serve real files/directories directly.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Pass everything else to Passenger (Django).
    RewriteRule ^ - [L]
</IfModule>
